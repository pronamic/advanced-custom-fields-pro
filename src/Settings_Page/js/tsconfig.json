{
	"compilerOptions": {
		"target": "ES2020",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"jsx": "react-jsx",
		"lib": [ "ES2020", "DOM", "DOM.Iterable" ],
		"strict": true,
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"allowJs": true,
		"esModuleInterop": true,
		"skipLibCheck": true
	},
	"include": [
		"types/**/*.d.ts",
		"**/*.ts",
		"**/*.tsx",
		"../../Pro/Settings_Page/js/**/*.ts",
		"../../Pro/Settings_Page/js/**/*.tsx",
		"../../Pro/License_Tab/js/**/*.ts",
		"../../Pro/License_Tab/js/**/*.tsx",
		"../../Pro/Updates_Tab/js/**/*.ts",
		"../../Pro/Updates_Tab/js/**/*.tsx"
	]
}
